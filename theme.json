{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#f6f8f4" },
				{ "slug": "base-2", "name": "Base 2", "color": "#e9efe4" },
				{ "slug": "contrast", "name": "Contrast", "color": "#14261d" },
				{ "slug": "contrast-2", "name": "Contrast 2", "color": "#4b5d52" },
				{ "slug": "accent", "name": "Accent (Sun)", "color": "#f2b01e" },
				{ "slug": "on-accent", "name": "Text on Accent", "color": "#14261d" },
				{ "slug": "line", "name": "Line", "color": "#cfd9cb" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1180px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2.5vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 4vw, 2.75rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 6vw, 4.5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(3.5rem, 9vw, 7rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body (system sans)",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Heading (system serif)",
					"fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Cambria, Georgia, serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.5rem", "fluid": { "min": "2.4rem", "max": "3.5rem" } }
			]
		},
		"custom": {
			"radius": { "small": "6px", "medium": "14px", "pill": "999px" },
			"shadow": "0 1px 2px rgba(20, 38, 29, 0.06), 0 8px 24px rgba(20, 38, 29, 0.08)"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "700",
					"lineHeight": "1.15"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large", "letterSpacing": "-0.01em" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|on-accent"
				},
				"border": { "radius": "var:custom|radius|pill" },
				"spacing": { "padding": { "top": "0.7em", "bottom": "0.7em", "left": "1.4em", "right": "1.4em" } },
				"typography": { "fontWeight": "600", "fontSize": "var:preset|font-size|medium" },
				":hover": { "color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" } },
				":focus": { "outline": { "color": "var:preset|color|contrast", "offset": "3px", "style": "solid", "width": "2px" } }
			},
			"caption": { "typography": { "fontSize": "var:preset|font-size|small" }, "color": { "text": "var:preset|color|contrast-2" } }
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "700", "fontSize": "var:preset|font-size|large" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|medium", "fontWeight": "500" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|line" },
				"border": { "width": "1px" }
			},
			"core/post-date": {
				"typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|small" },
				"color": { "text": "var:preset|color|contrast-2" }
			},
			"core/details": {
				"border": { "bottom": { "color": "var:preset|color|line", "width": "1px", "style": "solid" } },
				"spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem" } }
			},
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|accent", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25rem" } }
			}
		}
	},
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing (no title)", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
